{
    // GitHub Codespaces / VS Code Dev Containers: the full platform for testing.
    // Laravel (PHP 8.4) + MariaDB + Mailpit (catches sign-in codes) + Node + Chromium (PDFs)
    // + Swiss Ephemeris engine. Setup runs in .devcontainer/setup.sh (log: /tmp/arj-setup.log).
    "name": "Astro Rajnath Jha platform",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "runServices": ["app", "db", "mailpit"],
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "shutdownAction": "stopCompose",
    "remoteUser": "vscode",
    "hostRequirements": { "cpus": 2, "memory": "4gb" },
    "features": {
        "ghcr.io/devcontainers/features/node:1": { "version": "22" }
    },
    "forwardPorts": [8000, "mailpit:8025"],
    "portsAttributes": {
        "8000": { "label": "Website + admin", "onAutoForward": "openBrowser" }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh 2>&1 | tee /tmp/arj-setup.log",
    "postStartCommand": "bash .devcontainer/start.sh",
    "customizations": {
        "vscode": {
            "extensions": ["bmewburn.vscode-intelephense-client", "bradlc.vscode-tailwindcss"]
        },
        "codespaces": {
            "openFiles": ["docs/ops/codespaces.md"]
        }
    }
}
