{$DOMAIN} {
	encode zstd gzip
	root * /srv/public
	# Static files first; everything else goes to Laravel (PHP-FPM in the "app" container).
	@static file
	handle @static {
		header /build/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	php_fastcgi app:9000 {
		root /var/www/backend/public
	}
	request_body {
		max_size 12MB
	}
	log {
		output stdout
		format json
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# In-app calls (LiveKit signalling). Remove if you do not run the "calls" profile.
rtc.{$DOMAIN} {
	reverse_proxy host.docker.internal:7880
}
