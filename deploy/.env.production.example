# Copy to deploy/.env.production on the server (chmod 600). Never commit the real file.
DOMAIN=astrorajnathjha.com
APP_NAME="Astro Rajnath Jha"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://astrorajnathjha.com
# Generate once: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=*

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=arj
DB_USERNAME=arj
DB_PASSWORD=change-me-long-random
MARIADB_PASSWORD=change-me-long-random
MARIADB_ROOT_PASSWORD=change-me-other-long-random

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
REDIS_HOST=redis

# Mail falls back to these only if Admin → Email & SMS is empty.
MAIL_MAILER=log

ARJ_EPHEM_BIN=/var/www/engine/bin/arj-ephem
# Server-side PDFs (installed in the Docker image)
PDF_CHROME_BINARY=/usr/bin/chromium
# Website/app languages shown to visitors (only after reviewing the translations)
SITE_LOCALES=en,hi
ARJ_EPHE_PATH=/var/www/engine/ephe
ARJ_ALLOW_PRIVATE_PROVIDER_HOSTS=false

# In-app calls (LiveKit). Generate: openssl rand -hex 16 (key) and openssl rand -base64 36 (secret).
# Enter the same values in Admin › Calling (URL wss://rtc.<DOMAIN>). Start with:
#   docker compose --profile calls up -d
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_VERSION=v1.9.0
